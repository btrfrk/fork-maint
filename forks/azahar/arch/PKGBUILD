# Maintainer: Jakob Linke <jakob@linke.cx>
# Azahar from the button-layers fork: touch buttons in touch-from-button maps.
# Builds out of tree from the checkout named by AZAHAR_SRC, submodules
# initialized; the source tree is never modified.
#
# Third-party libraries come from the bundled submodules, as in upstream's own
# Linux builds. The system-library route (AUR azahar-git) needs cpp-jwt,
# robin-map, ffmpeg4.4 and others that extra does not carry. SDL2 is the
# exception: it is the system sdl2-compat, as in the AUR azahar package, so
# controller handling matches that package.
#
# FFmpeg support (video dumping) needs FFmpeg 7 exactly; extra has a newer
# one, so it is off.

pkgname=azahar-btrfrk
_pkgname=azahar
pkgver=0
pkgrel=1
pkgdesc='Nintendo 3DS emulator based on Citra - button-layers fork'
arch=(x86_64)
url='https://azahar-emu.org/'
license=(GPL-2.0-or-later)
depends=(glibc hicolor-icon-theme libbacktrace libgcc libstdc++ qt6-base sdl2-compat qt6-multimedia zydis)
makedepends=(cmake git ninja qt6-tools)
provides=("$_pkgname")
conflicts=("$_pkgname")
options=(!lto)
source=()

_pkgsrc=${AZAHAR_SRC:?set AZAHAR_SRC to the azahar checkout}

pkgver() {
  git -C "$_pkgsrc" describe --long --tags --abbrev=7 \
    | sed 's/^v//; s/[^-]*-g/r&/; s/-/./g'
}

build() {
  cmake -S "$_pkgsrc" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_C_FLAGS_RELEASE=-DNDEBUG \
    -DCMAKE_CXX_FLAGS_RELEASE=-DNDEBUG \
    -DCITRA_USE_PRECOMPILED_HEADERS=OFF \
    -DCITRA_WARNINGS_AS_ERRORS=OFF \
    -DENABLE_QT_TRANSLATION=ON \
    -DENABLE_QT_UPDATE_CHECKER=OFF \
    -DENABLE_DISCORD_RPC=OFF \
    -DUSE_SYSTEM_SDL2=ON \
    -DENABLE_FFMPEG=OFF \
    -DENABLE_TESTS=OFF \
    -DENABLE_LTO=OFF \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  rm -r "$pkgdir/usr/lib"
  install -Dm644 "$_pkgsrc/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
}
